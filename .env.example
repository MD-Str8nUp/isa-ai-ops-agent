# ISA AI Ops Agent — Environment Configuration
# Copy to .env and fill in your values

# Domain for SSL (leave blank for localhost)
DOMAIN=agent.yourbusiness.com

# Agent port (auto-generated by secure-setup.sh)
AGENT_PORT=47293

# Timezone
TZ=Australia/Sydney

# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-...

# Optional integrations
# TELEGRAM_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# GOOGLE_SERVICE_ACCOUNT_PATH=/root/.clawdbot/google-sa.json
# NOTION_API_KEY=
# SMARTLEAD_API_KEY=
